{"name":"c1","settings":"{\"settings\":\"{\\n    \\\"vscode_custom_css.imports\\\": [\\n        \\\"file:///home/value/.vscode/extensions/brandonkirbyson.vscode-animations-2.0.7/dist/updateHandler.js\\\"\\n    ],\\n    \\\"workbench.startupEditor\\\": \\\"none\\\",\\n    \\\"window.newWindowProfile\\\": \\\"默认\\\",\\n    \\\"editor.fontFamily\\\": \\\"'Maple Mono', Consolas, 'Courier New', monospace\\\",\\n    \\\"editor.fontLigatures\\\": true,\\n    \\\"editor.cursorSmoothCaretAnimation\\\": \\\"on\\\",\\n    \\\"animations.CursorAnimation\\\": true,\\n    \\\"animations.Active\\\": \\\"Indent\\\",\\n    \\\"animations.Command-Palette\\\": \\\"Slide\\\",\\n    \\\"fastolympiccoding.runSettings\\\": {\\n        \\\".cpp\\\": {\\n            \\\"compileCommand\\\": \\\"g++ -std=c++23 -D_GLIBCXX_DEBUG ${path:${file}} -o ${path:${fileDirname}/${fileBasenameNoExtension}${exeExtname}}\\\",\\n            \\\"runCommand\\\": \\\"${path:${fileDirname}/${fileBasenameNoExtension}${exeExtname}}\\\"\\n        },\\n    },\\n    \\\"C_Cpp.vcFormat.newLine.beforeElse\\\": false,\\n    \\\"custom-ui-style.external.imports\\\": [],\\n    \\\"animations.UseCursorColorForCursorAnimation\\\": true,\\n    \\\"animations.Tabs\\\": \\\"Slide\\\",\\n    \\\"animations.Scrolling\\\": \\\"Slide\\\",\\n    \\\"editor.formatOnPaste\\\": true,\\n    \\\"extensions.experimental.affinity\\\": {\\n        \\\"asvetliakov.vscode-neovim\\\": 1\\n    },\\n    \\\"[cpp]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"llvm-vs-code-extensions.vscode-clangd\\\"\\n    },\\n    \\\"[c]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"llvm-vs-code-extensions.vscode-clangd\\\"\\n    },\\n    \\\"C_Cpp.intelliSenseEngine\\\": \\\"disabled\\\",\\n    \\\"editor.formatOnSave\\\": true,\\n    \\\"editor.formatOnType\\\": true,\\n    \\\"C_Cpp.clang_format_style\\\": \\\"file\\\",\\n    \\\"C_Cpp.formatting\\\": \\\"vcFormat\\\",\\n    \\\"editor.detectIndentation\\\": false,\\n    \\\"editor.tabSize\\\": 4, // 保险起见再写一次\\n    \\\"editor.insertSpaces\\\": true,\\n    \\\"window.menuBarVisibility\\\": \\\"toggle\\\",\\n    \\\"diffEditor.codeLens\\\": true,\\n    \\\"workbench.secondarySideBar.showLabels\\\": false,\\n    \\\"workbench.activityBar.iconClickBehavior\\\": \\\"focus\\\",\\n    \\\"apc.imports\\\": [\\n        \\\"file://${userHome}/.vscode/extensions/brandonkirbyson.vscode-animations-2.0.7/dist/updateHandler.js\\\"\\n    ],\\n    \\\"animations.Install-Method\\\": \\\"Apc Customize UI++\\\",\\n    \\\"git.autofetch\\\": true,\\n    \\\"cph.language.cpp.compile\\\": \\\"g++ -std=c++20 -o2 -Wall $fileNameWithoutExt $fileName\\\",\\n    \\\"editor.fontVariations\\\": true,\\n    \\\"workbench.fontAliasing\\\": \\\"antialiased\\\",\\n    \\\"window.titleBarStyle\\\": \\\"custom\\\",\\n    \\\"cph.language.csharp.Args\\\": \\\"-std=c++20 -o2 -Wall\\\",\\n    \\\"fonted.font\\\": \\\"MonoLisa-Light\\\",\\n    \\\"workbench.editor.empty.hint\\\": \\\"hidden\\\",\\n    \\\"diffEditor.maxComputationTime\\\": 3000,\\n    \\\"workbench.iconTheme\\\": \\\"catppuccin-latte\\\",\\n    \\\"github.copilot.enable\\\": {\\n        \\\"*\\\": true,\\n        \\\"plaintext\\\": false,\\n        \\\"markdown\\\": false,\\n        \\\"scminput\\\": false,\\n        \\\"cpp\\\": false\\n    },\\n    \\\"kilo-code.allowedCommands\\\": [\\n        \\\"git log\\\",\\n        \\\"git diff\\\",\\n        \\\"git show\\\",\\n        \\\"hexdump -C boot.bin\\\",\\n        \\\"grep -A 2 \\\\\\\"000000e0\\\\\\\"\\\",\\n        \\\"hexdump\\\",\\n        \\\"grep\\\",\\n        \\\"make clean\\\",\\n        \\\"make\\\",\\n        \\\"timeout 5 qemu-system-i386 -drive format=raw,file=os.img -nographic 2>&1\\\",\\n        \\\"true\\\",\\n        \\\"timeout\\\",\\n        \\\"timeout 5\\\",\\n        \\\"timeout 5 qemu-system-i386\\\",\\n        \\\"ndisasm -b 32 boot.bin\\\",\\n        \\\"grep -A 20 \\\\\\\"000000d0\\\\\\\"\\\",\\n        \\\"ndisasm\\\",\\n        \\\"ndisasm -b 16 boot.bin\\\",\\n        \\\"head -150\\\",\\n        \\\"tail -50\\\",\\n        \\\"head\\\",\\n        \\\"tail\\\",\\n        \\\"mkdir -p boot kernel lib include device fs shell\\\",\\n        \\\"mkdir\\\",\\n        \\\"mkdir -p mini_os/{boot,kernel,lib,device,thread}\\\",\\n        \\\"ls -la\\\",\\n        \\\"ls\\\",\\n        \\\"cd\\\",\\n        \\\"cd mini_os\\\",\\n        \\\"cp os/src/boot/mbr.s mini_os/boot/mbr.s\\\",\\n        \\\"cp os/src/boot/loader.s mini_os/boot/loader.s\\\",\\n        \\\"cp\\\",\\n        \\\"hexdump -C hd60M.img\\\",\\n        \\\"head -5\\\",\\n        \\\"tail -2\\\",\\n        \\\"echo \\\\\\\"---\\\\\\\"\\\",\\n        \\\"echo\\\",\\n        \\\"objdump -D -b binary -mi386 -Maddr16,data16 boot/mbr.bin\\\",\\n        \\\"head -30\\\",\\n        \\\"objdump\\\",\\n        \\\"dd\\\",\\n        \\\"dd if=boot/mbr.bin of=floppy.img bs=512 count=1\\\",\\n        \\\"timeout 5 qemu-system-i386 -drive format=raw,file=floppy.img,if=floppy -m 32M -nographic -no-reboot\\\",\\n        \\\"timeout 5 qemu-system-i386 -drive format=raw,file=hd60M.img,if=ide -m 32M -nographic -no-reboot -S -s 2>&1\\\",\\n        \\\"head -20\\\",\\n        \\\"nasm -f bin boot/test_mbr.s -o boot/test_mbr.bin\\\",\\n        \\\"dd if=boot/test_mbr.bin of=test.img bs=512 count=1\\\",\\n        \\\"timeout 5 qemu-system-i386 -drive format=raw,file=test.img,if=ide -m 32M -nographic -no-reboot\\\",\\n        \\\"rm -f hd60M.img\\\",\\n        \\\"qemu-img create -f raw hd60M.img 60M\\\",\\n        \\\"dd if=boot/mbr.bin of=hd60M.img bs=512 count=1 conv=notrunc\\\",\\n        \\\"dd if=boot/loader.bin of=hd60M.img bs=512 count=8 seek=1 conv=notrunc\\\",\\n        \\\"dd if=kernel.bin of=hd60M.img bs=512 count=200 seek=10 conv=notrunc\\\",\\n        \\\"rm\\\",\\n        \\\"qemu-img\\\",\\n        \\\"qemu-img create\\\",\\n        \\\"cd /home/value/os2/mini_os\\\",\\n        \\\"bochs -f bochsrc.disk -q\\\",\\n        \\\"bochs\\\",\\n        \\\"reade