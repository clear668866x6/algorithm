  \\\"key\\\": \\\"ctrl+alt+;\\\",\\n        \\\"command\\\": \\\"fastolympiccoding.insertFileTemplate\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+alt+i\\\",\\n        \\\"command\\\": \\\"-fastolympiccoding.insertFileTemplate\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+alt+u\\\",\\n        \\\"command\\\": \\\"cph.runTestCases\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+alt+b\\\",\\n        \\\"command\\\": \\\"-cph.runTestCases\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+alt+'\\\",\\n        \\\"command\\\": \\\"cph.judgeView.focus\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+alt+d\\\",\\n        \\\"command\\\": \\\"-cph.judgeView.focus\\\"\\n    }\\n]\",\"platform\":2}","snippets":"{\"snippets\":{\"1.cpp.code-snippets\":\"{\\n    \\\"\\\": {\\n        \\\"prefix\\\": \\\"lg\\\",\\n        \\\"body\\\": [\\n            \\\"#include <bits/stdc++.h>\\\",\\n            \\\"using namespace std;\\\",\\n            \\\"\\\",\\n            \\\"using i64 = long long;\\\",\\n            \\\"using u64 = unsigned long long;\\\",\\n            \\\"using i128 = __int128;\\\",\\n            \\\"\\\",\\n            \\\"void solve() {\\\",\\n            \\\"    \\\",\\n            \\\"}\\\",\\n            \\\"\\\",\\n            \\\"int main() {\\\",\\n            \\\"    ios::sync_with_stdio(false);\\\",\\n            \\\"    cin.tie(nullptr);\\\",\\n            \\\"\\\",\\n            \\\"    int t = 1;\\\",\\n            \\\"    while (t--) {\\\",\\n            \\\"        solve();\\\",\\n            \\\"    }\\\",\\n            \\\"\\\",\\n            \\\"    return 0;\\\",\\n            \\\"}\\\"\\n        ],\\n        \\\"description\\\": \\\"\\\"\\n    }\\n}\",\"2.cpp.code-snippets\":\"{\\n    \\\"\\\": {\\n        \\\"prefix\\\": \\\"cf\\\",\\n        \\\"body\\\": [\\n            \\\"#include <bits/stdc++.h>\\\",\\n            \\\"using namespace std;\\\",\\n            \\\"\\\",\\n            \\\"using i64 = long long;\\\",\\n            \\\"using u64 = unsigned long long;\\\",\\n            \\\"using i128 = __int128;\\\",\\n            \\\"\\\",\\n            \\\"void solve() {\\\",\\n            \\\"    \\\",\\n            \\\"}\\\",\\n            \\\"\\\",\\n            \\\"int main() {\\\",\\n            \\\"    ios::sync_with_stdio(false);\\\",\\n            \\\"    cin.tie(nullptr);\\\",\\n            \\\"\\\",\\n            \\\"    int t = 1;\\\",\\n            \\\"    cin >> t;\\\",\\n            \\\"    while (t--) {\\\",\\n            \\\"        solve();\\\",\\n            \\\"    }\\\",\\n            \\\"\\\",\\n            \\\"    return 0;\\\",\\n            \\\"}\\\"\\n        ],\\n        \\\"description\\\": \\\"\\\"\\n    }\\n}\",\"3.py.code-snippets\":\"{\\n    \\\"\\\": {\\n        \\\"prefix\\\": \\\"plg\\\",\\n        \\\"body\\\": [\\n            \\\"import sys\\\",\\n            \\\"import math\\\",\\n            \\\"from collections import defaultdict, deque, Counter\\\",\\n            \\\"from heapq import *\\\",\\n            \\\"from itertools import accumulate, combinations, permutations\\\",\\n            \\\"from bisect import bisect_left, bisect_right\\\",\\n            \\\"\\\",\\n            \\\"input = lambda: sys.stdin.readline().strip()\\\",\\n            \\\"\\\",\\n            \\\"def solve():\\\",\\n            \\\"   \\\",\\n            \\\"\\\",\\n            \\\"def main():\\\",\\n            \\\"    Task = 1\\\",\\n            \\\"    for _ in range(Task):\\\",\\n            \\\"       solve()\\\",\\n            \\\"\\\",\\n            \\\"main()\\\",\\n            \\\"\\\"\\n        ],\\n        \\\"description\\\": \\\"\\\"\\n    }\\n}\",\"4.py.code-snippets\":\"{\\n    \\\"\\\": {\\n        \\\"prefix\\\": \\\"pcf\\\",\\n        \\\"body\\\": [\\n            \\\"import sys\\\",\\n            \\\"import math\\\",\\n            \\\"from collections import defaultdict, deque, Counter\\\",\\n            \\\"from heapq import *\\\",\\n            \\\"from itertools import accumulate, combinations, permutations\\\",\\n            \\\"from bisect import bisect_left, bisect_right\\\",\\n            \\\"\\\",\\n            \\\"input = lambda: sys.stdin.readline().strip()\\\",\\n            \\\"\\\",\\n            \\\"def solve():\\\",\\n            \\\"   \\\",\\n            \\\"\\\",\\n            \\\"def main():\\\",\\n            \\\"    Task = int(input())\\\",\\n            \\\"    for _ in range(Task):\\\",\\n            \\\"       solve()\\\",\\n            \\\"\\\",\\n            \\\"main()\\\",\\n            \\\"\\\"\\n        ],\\n        \\\"description\\\": \\\"\\\"\\n    }\\n}\",\"5.rs.code-snippets\":\"{\\n    \\\"\\\": {\\n        \\\"prefix\\\": \\\"rlg\\\",\\n        \\\"body\\\": [\\n            \\\"use std::io::{self, Write, BufWriter, Read};\\\",\\n            \\\"use std::collections::*;\\\",\\n            \\\"use io_util::FastInput;\\\",\\n            \\\"\\\",\\n            \\\"mod io_util {\\\",\\n            \\\"    use super::*;\\\",\\n            \\\"    \\\",\\n            \\\"    pub struct FastInput<'a> {\\\",\\n            \\\"        iter: std::str::SplitWhitespace<'a>,\\\",\\n            \\\"    }\\\",\\n            \\\"\\\",\\n            \\\"    impl<'a> FastInput<'a> {\\\",\\n            \\\"        pub fn new(s: &'a str) -> Self {\\\",\\n            \\\"            Self {\\\",\\n            \\\"                iter: s.split_whitespace(),\\\",\\n            \\\"            }\\\",\\n            \\\"        }\\\",\\n            \\\"\\\",\\n            \\\"        pub fn read<T: std::str::FromStr>(&mut self) -> T {\\\",\\n            \\\"            self.iter.next().unwrap().parse().ok().unwrap()\\\",\\n            \\\"        }\\\",\\n            \\\"\\\",\\n            \\\"        pub fn i32(&mut self) -> i32 { self.read() }\\\",\\n            \\\"        pub fn i64(&mut self) -> i64 { self.read() }\\\",\\n            \\\"        pub fn usize(&mut self) -> usize { self.read() }\\\",\\n            \\\"        pub fn u32(&mut self) -> u32 { self.read() }\\\",\\n            \\\"        pub fn u64(&mut self) -> u64 { self.read() }\\\",\\n            \\\"        pub fn f64(&mut self) -> f64 { self.read() }\\\",\\n            \\\"        pub fn string(&mut self) -> String { self.read() }\\\",\\n            \\\"\\\",\\n            \\\"        pub fn bytes(&mut self) -> Vec<u8> {\\\",\\n            \\\"            self.iter.next().unwrap().bytes().collect()\\\",\\n            \\\"        }\\\",\\n            \\\"\\\",\\n            \\\"        pub fn chars(&mut self) -> Vec<char> {\\\",\\n            \\\"            self.iter.next().unwrap().chars().collect()\\\",\\n            \\\"        }\\\",\\n            \\\"\\\",\\n            \\\"        pub fn vec<T: std::str::FromStr>(&mut self, n: usize) -> Vec<T> {\\\",\\n            \\\"            (0..n).map(|_| self.read()).collect()\\\",\\n            \\\"        }\\\",\\n            \\\"\\\",\\n            \\\"        pub fn tuple2<T: std::str::FromStr, U: std::str::FromStr>(&mut self) -> (T, U) {\\\",\\n            \\\"            (self.read(), self.read())\\\",\\n            \\\"        }\\\",\\n            \\\"\\\",\\n            \\\"        pub fn tuple3<T: std::str::FromStr, U: std::str::FromStr, V: std::str::FromStr>(&mut self) -> (T, U, V) {\\\",\\n            \\\"            (self.read(), self.read(), self.read())\\\",\\n            \\\"        }\\\",\\n            \\\"    }\\\",\\n            \\\"}\\\",\\n            \\\"\\\",\\n            \\\"fn solve(sc: &mut FastInput, out: &mut BufWriter<io::StdoutLock>) {\\\",\\n            \\\"    \\\",\\n            \\\"}\\\",\\n            \\\"\\\",\\n            \\\"fn main() {\\\",\\n            \\\"    let mut input_string = String::new();\\\",\\n            \\\"    io::stdin().read_to_string(&mut input_string).unwrap();\\\",\\n            \\\"    \\\",\\n            \\\"    let mut sc = FastInput::new(&input_string);\\\",\\n            \\\"    \\\",\\n            \\\"    let stdout = io::stdout();\\\",\\n            \\\"    let mut out = BufWriter::new(stdout.lock());\\\",\\n            \\\"    \\\",\\n            \\\"    let t = 1;\\\",\\n            \\\"    for _ in 0..t {\\\",\\n            \\\"        solve(&mut sc, &mut out);\\\",\\n            \\\"    }\\\",\\n            \\\"}\\\",\\n            \\\"\\\"\\n        ],\\n        \\\"description\\\": \\\"\\\"\\n    }\\n}\",\"6.rs.code-snippets\":\"{\\n    \\\"\\\": {\\n        \\\"prefix\\\": \\\"rcf\\\",\\n        \\\"body\\\": [\\n            \\\"use std::io::{self, Write, BufWriter, Read};\\\",\\n            \\\"use std::collections::*;\\\",\\n            \\\"use io_util::FastInput;\\\",\\n            \\\"\\\",\\n            \\\"mod io_util {\\\",\\n            \\\"    use super::*;\\\",\\n            \\\"    \\\",\\n            \\\"    pub struct FastInput<'a> {\\\",\\n            \\\"        iter: std::str::SplitWhitespace<'a>,\\\",\\n            \\\"    }\\\",\\n            \\\"\\\",\\n            \\\"    impl<'a> FastInput<'a> {\\\",\\n            \\\"        pub fn new(s: &'a str) -> Self {\\\",\\n            \\\"            Self {\\\",\\n            \\\"                iter: s.split_whitespace(),\\\",\\n            \\\"            }\\\",\\n            \\\"        }\\\",\\n            \\\"\\\",\\n            \\\"        pub fn read<T: std::str::FromStr>(&mut self) -> T {\\\",\\n            \\\"            self.iter.next().unwrap().parse().ok().unwrap()\\\",\\n            \\\"        }\\\",\\n            \\\"\\\",\\n            \\\"        pub fn i32(&mut self) -> i32 { self.read() }\\\",\\n            \\\"        pub fn i64(&mut self) -> i64 { self.read() }\\\",\\n            \\\"        pub fn usize(&mut self) -> usize { self.read() }\\\",\\n            \\\"        pub fn u32(&mut self) -> u32 { self.read() }\\\",\\n            \\\"        pub fn u64(&mut self) -> u64 { self.read() }\\\",\\n            \\\"        pub fn f64(&mut self) -> f64 { self.read() }\\\",\\n            \\\"        pub fn string(&mut self) -> String { self.read() }\\\",\\n            \\\"\\\",\\n            \\\"        pub fn bytes(&mut self) -> Vec<u8> {\\\",\\n            \\\"            self.iter.next().unwrap().bytes().collect()\\\",\\n            \\\"        }\\\",\\n            \\\"\\\",\\n            \\\"        pub fn chars(&mut self) -> Vec<char> {\\\",\\n            \\\"            self.iter.next().unwrap().chars().collect()\\\",\\n            \\\"        }\\\",\\n            \\\"\\\",\\n            \\\"        pub fn vec<T: std::str::FromStr>(&mut self, n: usize) -> Vec<T> {\\\",\\n            \\\"            (0..n).map(|_| self.read()).collect()\\\",\\n            \\\"        }\\\",\\n            \\\"\\\",\\n            \\\"        pub fn tuple2<T: std::str::FromStr, U: std::str::FromStr>(&mut self) -> (T, U) {\\\",\\n            \\\"            (self.read(), self.read())\\\",\\n            \\\"        }\\\",\\n            \\\"\\\",\\n            \\\"        pub fn tuple3<T: std::str::FromStr, U: std::str::FromStr, V: std::str::FromStr>(&mut self) -> (T, U, V) {\\\",\\n            \\\"            (self.read(), self.read(), self.read())\\\",\\n            \\\"        }\\\",\\n            \\\"    }\\\",\\n            \\\"}\\\",\\n            \\\"\\\",\\n            \\\"fn solve(sc: &mut FastInput, out: &mut BufWriter<io::StdoutLock>) {\\\",\\n            \\\"    \\\",\\n            \\\"}\\\",\\n            \\\"\\\",\\n            \\\"fn main() {\\\",\\n            \\\"    let mut input_string = String::new();\\\",\\n            \\\"    io::stdin().read_to_string(&mut input_string).unwrap();\\\",\\n            \\\"    \\\",\\n            \\\"    let mut sc = FastInput::new(&input_string);\\\",\\n            \\\"    \\\",\\n            \\\"    let stdout = io::stdout();\\\",\\n            \\\"    let mut out = BufWriter::new(stdout.lock());\\\",\\n            \\\"    \\\",\\n            \\\"    let t = sc.usize();\\\",\\n            \\\"    for _ in 0..t {\\\",\\n            \\\"        solve(&mut sc, &mut out);\\\",\\n            \\\"    }\\\",\\n            \\\"}\\\",\\n            \\\"\\\"\\n        ],\\n        \\\"description\\\": \\\"\\\"\\n    }\\n}\"}}","extensions":"[{\"identifier\":{\"id\":\"adpyke.codesnap\",\"uuid\":\"8c1fc960-44b1-45e8-89b5-85f982fdaf27\"},\"displayName\":\"CodeSnap\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"catppuccin.catppuccin-vsc-icons\",\"uuid\":\"625b9abd-dfac-405b-bf34-e65f46e2f22f\"},\"displayName\":\"Catppuccin Icons for VSCode\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"danielpinto8zz6.c-cpp-compile-run\",\"uuid\":\"f3b153f9-13ba-4992-9f90-1779d968df49\"},\"displayName\":\"C/C++ Compile Run\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"degreat.fonted\",\"uuid\":\"42e4cd86-c868-4f52-9700-88be10401033\"},\"displayName\":\"fonted\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"divyanshuagrawal.competitive-programming-helper\",\"uuid\":\"28579c42-9973-4b79-9a1e-76431ea4bc1f\"},\"displayName\":\"Competitive Programming Helper (cph)\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"formulahendry.code-runner\",\"uuid\":\"a6a0c5b2-d078-4bf5-a9ee-4e37054414b3\"},\"displayName\":\"Code Runner\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"franneck94.c-cpp-runner\",\"uuid\":\"0f4eac03-b4ec-4a55-bce1-deb41fde32ab\"},\"displayName\":\"C/C++ Runner\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"golang.go\",\"uuid\":\"d6f6cfea-4b6f-41f4-b571-6ad2ab7918da\"},\"displayName\":\"Go\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"jeff-hykin.better-cpp-syntax\",\"uuid\":\"73767f91-7dcb-43cb-90b3-596d073eea1f\"},\"displayName\":\"Better C++ Syntax\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"kilocode.kilo-code\",\"uuid\":\"849d53b8-0eb4-4e6b-b73f-870eefcbbf1b\"},\"displayName\":\"Kilo Code: AI Coding Agent, Copilot, and Autocomplete\",\"applicationScoped\":false},{\"